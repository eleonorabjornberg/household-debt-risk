# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase (optional). When URL + key are set, pages read the `mart` schema via PostgREST.
# Use the publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
# When unset, pages read public/data/*.json (pipeline snapshots), then fixtures/*.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
