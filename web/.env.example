# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase (optional). When URL + key are set, pages read the `mart` schema via PostgREST.
# Use the publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
# When unset, pages read public/data/*.json (pipeline snapshots), then fixtures/*.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tableau, all optional. NEXT_PUBLIC_* values are inlined at build time: change them, then redeploy.
#
# Option 1 (start here): Tableau Public. Setting the profile turns Public mode on (it wins over Cloud).
# Views load from https://public.tableau.com/views/WhoHoldsTheDebt/<Sheet> with no token.
NEXT_PUBLIC_TABLEAU_PUBLIC_PROFILE=
# Comma-separated sheet names that are actually published, e.g. "Ratchet" or
# "Ratchet,CrisisSmallMultiples,Collateral,PaymentPriority". Unlisted figures keep the native chart.
# Unset/blank = embed nothing (native charts everywhere), so unpublished sheets never show broken iframes.
NEXT_PUBLIC_TABLEAU_VIEWS=

# Option 2 (upgrade later): Tableau Cloud with Connected Apps (direct trust). Used only when the Public
# profile above is blank and all five required values are set; otherwise /api/tableau-token returns 503.
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_CONNECTED_APP_CLIENT_ID=
TABLEAU_CONNECTED_APP_SECRET_ID=
TABLEAU_CONNECTED_APP_SECRET_VALUE=
TABLEAU_EMBED_USER=
