  <worksheets>
    <worksheet name='Ratchet – main'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Share of US household mortgages + consumer credit, by who holds the risk</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ratchet' name='federated.fuastzwmj3dygtt66pqgja3dp4fw' />
          </datasources>
          <datasource-dependencies datasource='federated.fuastzwmj3dygtt66pqgja3dp4fw'>
            <column caption='Bucket label' datatype='string' name='[bucket_label]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Share of total' datatype='real' default-format='p0%' name='[share_of_total]' role='measure' type='quantitative' />
            <column-instance column='[bucket_label]' derivation='None' name='[none:bucket_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[share_of_total]' derivation='Sum' name='[sum:share_of_total:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Quarter-Trunc' name='[tqr:date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.fuastzwmj3dygtt66pqgja3dp4fw].[none:bucket_label:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Federal government (direct)&quot;</bucket>
              <bucket>&quot;GSEs &amp; agency pools&quot;</bucket>
              <bucket>&quot;State &amp; local governments&quot;</bucket>
              <bucket>&quot;Banks &amp; credit unions&quot;</bucket>
              <bucket>&quot;Private securitization &amp; mortgage REITs&quot;</bucket>
              <bucket>&quot;Finance companies &amp; other private&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.fuastzwmj3dygtt66pqgja3dp4fw].[sum:share_of_total:qk]' field-type='quantitative' max='1.0' min='0.0' range-type='fixed' scope='rows' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Area' />
            <encodings>
              <color column='[federated.fuastzwmj3dygtt66pqgja3dp4fw].[none:bucket_label:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.fuastzwmj3dygtt66pqgja3dp4fw].[sum:share_of_total:qk]</rows>
        <cols>[federated.fuastzwmj3dygtt66pqgja3dp4fw].[tqr:date:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Public share'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Public share: federal government + GSEs/agency pools + state &amp; local</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ratchet' name='federated.fuastzwmj3dygtt66pqgja3dp4fw' />
          </datasources>
          <datasource-dependencies datasource='federated.fuastzwmj3dygtt66pqgja3dp4fw'>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Public share' datatype='real' default-format='p0.0%' name='[public_share]' role='measure' type='quantitative' />
            <column-instance column='[public_share]' derivation='Avg' name='[avg:public_share:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Quarter-Trunc' name='[tqr:date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.fuastzwmj3dygtt66pqgja3dp4fw].[avg:public_share:qk]</rows>
        <cols>[federated.fuastzwmj3dygtt66pqgja3dp4fw].[tqr:date:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
