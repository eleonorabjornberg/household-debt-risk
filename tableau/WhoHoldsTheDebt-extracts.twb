    </window>
    <window class='dashboard' name='Collateral'>
      <viewpoints>
        <viewpoint name='Collateral – share'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='Collateral – coverage'>
          <zoom type='entire-view' />
        </viewpoint>
      </viewpoints>
      <active id='-1' />
    </window>
    <window class='dashboard' name='PaymentPriority'>
      <viewpoints>
        <viewpoint name='Payment priority – main'>
          <zoom type='entire-view' />
        </viewpoint>
      </viewpoints>
      <active id='-1' />
    </window>
  </windows>
</workbook>
