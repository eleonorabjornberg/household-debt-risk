<?xml version='1.0' encoding='utf-8' ?>

<!--
  Who Holds the Debt? - Tableau data source (starter).
  Connection is preset to the household-debt-risk Supabase project (session pooler, us-east-1).
  Tableau asks for the tableau_reader password on first connect; store it as "Embedded password" when publishing.

  Contents: mart.public_share LEFT JOIN mart.debt_by_risk_holder ON date, INNER JOIN core.dim_risk_bucket ON risk_bucket.
  Grain: date x risk_bucket x debt_type. Columns from public_share repeat on every row, so always aggregate them with AVG
  (the calculated fields below already do this).
  This covers the Ratchet dashboard. For the other dashboards, add mart.crisis_event_window, mart.collateral_coverage,
  mart.nyfed_by_type and core.dim_crisis as separate logical tables (relationships) in Desktop, as described in workbook_specs.md 0.1.
  Legacy (single-relation) format so that any Tableau version from 2020.2 on opens it and upgrades it in place.
-->
<datasource formatted-name='hhdebt' inline='true' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='Supabase session pooler' name='postgres.hhdebt'>
        <connection authentication='username-password' class='postgres' dbname='postgres' odbc-native-protocol='yes' one-time-sql='' port='5432' server='aws-0-us-east-1.pooler.supabase.com' sslmode='require' username='tableau_reader.ldckwcqucdnwarysqmgj' />
      </named-connection>
    </named-connections>
    <relation join='inner' type='join'>
      <clause type='join'>
        <expression op='='>
          <expression op='[debt_by_risk_holder].[risk_bucket]' />
          <expression op='[dim_risk_bucket].[risk_bucket]' />
        </expression>
      </clause>
      <relation join='left' type='join'>
        <clause type='join'>
          <expression op='='>
            <expression op='[public_share].[date]' />
            <expression op='[debt_by_risk_holder].[date]' />
          </expression>
        </clause>
        <relation connection='postgres.hhdebt' name='public_share' table='[mart].[public_share]' type='table' />
        <relation connection='postgres.hhdebt' name='debt_by_risk_holder' table='[mart].[debt_by_risk_holder]' type='table' />
      </relation>
      <relation connection='postgres.hhdebt' name='dim_risk_bucket' table='[core].[dim_risk_bucket]' type='table' />
    </relation>
  </connection>
  <aliases enabled='yes' />

  <!-- Calculated fields (formulas mirror workbook_specs.md 0.3 and 1) -->
  <column caption='Quarter label' datatype='string' name='[Calc_QuarterLabel]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='STR(YEAR([date])) + &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date]))' />
  </column>
  <column caption='Public / private' datatype='string' name='[Calc_PublicPrivate]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [is_public] THEN &quot;Public&quot; ELSE &quot;Private&quot; END' />
  </column>
  <column caption='Bucket share' datatype='real' default-format='p0.0%' name='[Calc_BucketShare]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([share_of_total])' />
  </column>
  <column caption='Bucket $T' datatype='real' default-format='c&quot;$&quot;#,##0.00' name='[Calc_BucketT]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([nominal_musd]) / 1e6' />
  </column>
  <column caption='Public share' datatype='real' default-format='p0.0%' name='[Calc_PublicShare]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([public_share])' />
  </column>
  <column caption='Fed MBS share' datatype='real' default-format='p0.0%' name='[Calc_FedMBSShare]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([fed_mbs_share_of_scope])' />
  </column>
  <column caption='Scope $T' datatype='real' default-format='c&quot;$&quot;#,##0.00' name='[Calc_ScopeT]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([scope_total_musd]) / 1e6' />
  </column>
  <column caption='Public $T' datatype='real' default-format='c&quot;$&quot;#,##0.00' name='[Calc_PublicT]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([public_musd]) / 1e6' />
  </column>
  <column caption='Is latest quarter' datatype='boolean' name='[Calc_IsLatest]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[date] = {FIXED : MAX([date])}' />
  </column>
  <column caption='Public share at 2007Q4' datatype='real' default-format='p0.0%' name='[Calc_PS2007]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{FIXED : MAX(IF [date] = #2007-12-31# THEN [public_share] END)}' />
  </column>

  <!-- Default colours: one bucket palette (cool = public, warm = private). Validated colour-blind safe on #FCFCFB. -->
  <style>
    <style-rule element='mark'>
      <encoding attr='color' field='[risk_bucket]' type='palette'>
        <map to='#1c5cab'>
          <bucket>&quot;federal_direct&quot;</bucket>
        </map>
        <map to='#1baf7a'>
          <bucket>&quot;gse_agency&quot;</bucket>
        </map>
        <map to='#3987e5'>
          <bucket>&quot;state_local&quot;</bucket>
        </map>
        <map to='#e34948'>
          <bucket>&quot;banks_credit_unions&quot;</bucket>
        </map>
        <map to='#eda100'>
          <bucket>&quot;private_securitization&quot;</bucket>
        </map>
        <map to='#e87ba4'>
          <bucket>&quot;nonbank_other&quot;</bucket>
        </map>
      </encoding>
      <encoding attr='color' field='[Calc_PublicPrivate]' type='palette'>
        <map to='#1c5cab'>
          <bucket>&quot;Public&quot;</bucket>
        </map>
        <map to='#e34948'>
          <bucket>&quot;Private&quot;</bucket>
        </map>
      </encoding>
    </style-rule>
  </style>
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
  </semantic-values>
</datasource>
