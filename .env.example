# Pipeline (Supabase Postgres via Supavisor pooler, session mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Read-only role research_reader (supabase/migrations/20261103000000_research_reader.sql); used by
# validation, the MCP server, evals and the site's Q&A. Same pooler host, user research_reader.<project-ref>.
DATABASE_URL_READONLY=postgresql://research_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: FRED API key (pipeline falls back to fredgraph.csv when unset)
FRED_API_KEY=

# Web (Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
