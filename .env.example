# Pipeline (Supabase Postgres via Supavisor pooler, session mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: FRED API key (pipeline falls back to fredgraph.csv when unset)
FRED_API_KEY=

# Web (Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TABLEAU_SERVER_URL=https://<pod>.online.tableau.com
TABLEAU_SITE=
TABLEAU_CONNECTED_APP_CLIENT_ID=
TABLEAU_CONNECTED_APP_SECRET_ID=
TABLEAU_CONNECTED_APP_SECRET_VALUE=
TABLEAU_EMBED_USER=
